{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@theme": ["src/theme"],
      "@theme/*": ["src/theme/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@store": ["src/store"],
      "@store/*": ["src/store/*"],
      "@api": ["src/api"],
      "@api/*": ["src/api/*"],
      "@constants": ["src/constants"],
      "@constants/*": ["src/constants/*"],
      "@app-types": ["src/types"],
      "@app-types/*": ["src/types/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@navigation": ["src/navigation"],
      "@navigation/*": ["src/navigation/*"],
      "@assets/*": ["src/assets/*"],
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@contexts": ["src/contexts"],
      "@contexts/*": ["src/contexts/*"]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.js"],
  "exclude": ["node_modules", "android", "ios"]
}
