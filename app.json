{
  "expo": {
    "name": "MBGA Delivery Partner",
    "slug": "mbga-delivery-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logos/mbga-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "mbga-delivery",
    "splash": {
      "image": "./src/assets/images/logos/mbga-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF2FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mbga.deliverypartner"
    },
    "android": {
      "package": "com.mbga.deliverypartner",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logos/mbga-logo.png",
        "backgroundColor": "#0067A5"
      }
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MBGA Delivery Partner uses your location to verify you've arrived at the delivery address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0067A5"
        }
      ]
    ]
  }
}
