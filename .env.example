# react-native-config loads this at native build time — copy to .env and
# fill in real values. Rebuild (not just reload) the app after changing it.

# Host only — endpoint paths carry their own /api/v1/delivery/... prefix
# (src/api/endpoints/). A trailing slash is stripped automatically.
API_BASE_URL=https://mbga.clocktales.com
API_TIMEOUT=15000

# Mock mode (src/api/mocks/) — false: requests go to the live API above.
# Defaults to true (mocked) if this var is unset entirely.
USE_MOCK_DATA=false
