# Expo loads .env / .env.local / .env.development / .env.production
# from the project root automatically — copy this to .env and fill in
# real values. Only EXPO_PUBLIC_-prefixed vars reach client code.
# (env/.env.* was react-native-config's convention and no longer applies.)

EXPO_PUBLIC_API_BASE_URL=http://10.0.0.199:8005
EXPO_PUBLIC_API_TIMEOUT=10000

# Mock mode (src/api/mocks/) — false now that the live API above is wired up.
# Defaults to true (mocked) if this var is unset entirely.
EXPO_PUBLIC_USE_MOCK_DATA=false
